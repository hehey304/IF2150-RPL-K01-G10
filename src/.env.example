# Port server HTTP
PORT=3000

# Opsional: koneksi PostgreSQL 15+. Jika dikosongkan, aplikasi memakai
# PGlite (PostgreSQL embedded) yang disimpan di folder PGLITE_DIR.
DATABASE_URL=

# Lokasi data PGlite (dipakai bila DATABASE_URL kosong). Isi "memory" untuk basis data sementara.
PGLITE_DIR=./data/pglite

# Isi basis data dengan data contoh saat pertama kali dijalankan (true/false)
SEED_ON_START=true

# Aturan bisnis
PAYMENT_TIMEOUT_MINUTES=15
AUTO_DEQUEUE_MINUTES=30
MENIT_PER_ANTREAN=3
BIAYA_LAYANAN=2000

# Folder penyimpanan dokumen pengajuan mitra
UPLOAD_DIR=./uploads

# Email simulasi: tautan reset kata sandi ditampilkan di layar karena email tidak benar-benar dikirim
EMAIL_SIMULASI=true

# Simulator antrean dummy: pelanggan dummy otomatis memesan di restoran yang mode simulasinya aktif
SIMULASI_ANTREAN=true
SIMULASI_INTERVAL_DETIK=15

# Kunci tanda tangan notifikasi payment gateway sandbox (HMAC-SHA256). Ganti untuk lingkungan bersama.
GATEWAY_SERVER_KEY=
