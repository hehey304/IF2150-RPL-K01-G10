{
  "name": "antri-in",
  "version": "1.0.0",
  "private": true,
  "description": "antri.in - pemesanan makanan viral dengan antrean digital (IF2150 K01 G10)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:client": "tsc -p tsconfig.client.json",
    "build": "npm run build:client",
    "dev": "npm run build:client && tsx watch server/index.ts",
    "start": "npm run build:client && tsx server/index.ts",
    "seed": "tsx server/db/seed-cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:pg": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "profile": "tsx scripts/profile-dashboard.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "bcryptjs": "^3.0.3",
    "express": "^4.22.3",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6"
  }
}
