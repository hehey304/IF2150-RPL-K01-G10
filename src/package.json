{
  "name": "antri-in",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=20.6" },
  "workspaces": ["backend", "frontend"],
  "typescript":"~5.9.3",
  "scripts": {
    "dev:be": "npm run dev -w backend",
    "dev:fe": "npm run dev -w frontend",
    "dev": "run-p dev:be dev:fe",
    "db:up": "docker compose up -d",
    "db:reset": "docker compose down -v && docker compose up -d",
    "test": "npm run test -w backend"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}